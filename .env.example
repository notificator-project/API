# Required data plane
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Expo push security
EXPO_ACCESS_TOKEN=
EXPO_PUSH_TIMEOUT_MS=10000

# Optional email delivery
RESEND_API_KEY=
ALERT_EMAIL_FROM=

# Optional deployment-owned HiveMQ Cloud connection
HIVEMQ_HOST=
HIVEMQ_PORT=8884
HIVEMQ_WSS_PATH=/mqtt
HIVEMQ_USERNAME=
HIVEMQ_PASSWORD=
HIVEMQ_TOPIC_PREFIX=notificator-project
