{
  "name": "notificator-project-public-api",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Notificator Project Public API",
  "author": "Vagelis P. <hello@vagelis.dev>",
  "contributors": [
    "Evan Derventzis <evangelos@derventzis.gr>"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "netlify dev",
    "deploy": "netlify deploy --prod",
    "format": "prettier --write \"{netlify,packages,test}/**/*.{js,mjs,ts,json,md}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{netlify,packages,test}/**/*.{js,mjs,ts,json,md}\" \"*.{json,md}\"",
    "test": "node --test",
    "test:sdk": "npm test --workspace @notificator-project/api",
    "pack:sdk": "npm pack --workspace @notificator-project/api --dry-run"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "mqtt": "^5.10.3",
    "resend": "^6.18.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "netlify-cli": "^27.0.1",
    "prettier": "^3.9.6"
  }
}
