{
  "name": "@notificator-project/api",
  "version": "0.1.0",
  "description": "Official Node.js client for sending alerts through the Notificator Public API.",
  "type": "module",
  "license": "MIT",
  "author": "Vagelis Papaioannou <hello@vagelis.dev>",
  "funding": "https://buymeacoffee.com/vagelis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notificator-project/API.git",
    "directory": "packages/api"
  },
  "bugs": {
    "url": "https://github.com/notificator-project/API/issues"
  },
  "homepage": "https://docs.notificator-project.com/reference/public-notify/",
  "keywords": [
    "notificator",
    "notifications",
    "push-notifications",
    "mqtt",
    "iot",
    "alerts",
    "webhooks"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "format:check": "prettier --check \"src/**/*.{js,ts}\" \"*.{json,md}\"",
    "prepublishOnly": "npm test && npm run format:check"
  },
  "publishConfig": {
    "access": "public"
  }
}
